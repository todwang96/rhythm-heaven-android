<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rhport.rhythm"
    android:versionCode="1"
    android:versionName="0.1-bringup">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Vulkan 1.1 is required by the nvn_vk backend -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00400000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:debuggable="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 启动器：数据包导入 + 画面/震动/音频设置，作为桌面入口 -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode" />

        <!-- Debug: mic recorder for cross-device audio verification (not a launch entry) -->
        <activity
            android:name=".MicRecActivity"
            android:exported="true" />
    </application>
</manifest>